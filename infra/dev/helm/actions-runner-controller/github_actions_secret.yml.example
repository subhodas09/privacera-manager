# Copy this file to github_actions_secret.yml and replace the placeholder.
# The real file is ignored by Git. Keep it only for quick development; use an
# external secret manager for a shared or production environment.
apiVersion: v1
kind: Secret
metadata:
  name: arc-github-auth
  namespace: arc-runners
  labels:
    app.kubernetes.io/part-of: actions-runner-controller
type: Opaque
stringData:
  github_token: REPLACE_WITH_GITHUB_PAT
