aws_region          = "ap-southeast-2"
aws_profile         = "privacera"
allowed_account_ids = ["111122223333"]
project_name        = "privacera"
environment         = "dev"
eks_cluster_name    = "privacera-cluster"
vpc_cidr            = "10.20.0.0/16"

# Set explicit AZs to avoid an account-specific ordering change. If omitted,
# Terraform selects the first three standard AZ names returned by AWS.
availability_zones = ["ap-southeast-2a", "ap-southeast-2b", "ap-southeast-2c"]

# false = one NAT gateway per AZ (resilient baseline); true = one shared NAT
# gateway (lower cost, but a single-AZ dependency).
single_nat_gateway = false

enable_vpc_endpoints = true
flow_log_retention_days = 90
protect_flow_logs = true

additional_tags = {
  CostCenter = "development"
  Owner      = "platform-team"
}
